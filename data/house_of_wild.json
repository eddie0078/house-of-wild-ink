    {
      "id": "poem-stones-verified",
      "slug": "stones",
      "title": "Stones",
      "content_type": "poem",
      "raw_content": "Diamond, Blue Sapphire, Ruby, Emerald;\nThe four most precious stones :\nPeridot, Turquoise, Moonstone, Garnet;\nFollowing close behind we are:\nFlint, Limestone, Dacite, Gneiss;\nWhat shall we say of ourselves?\nStones we all are, like humans different but alike",
      "excerpt": "Diamond, Blue Sapphire, Ruby, Emerald; The four most precious stones : Peridot, Turquoise, Moonstone, Garnet...",
      "author_credit": "L.E. Daniels | DEFFA",
      "alignment": "left",
      "reading_time_minutes": 1,
      "tags": [
        "Reflection",
        "Humanity",
        "Identity",
        "Precious"
      ],
      "status": "published",
